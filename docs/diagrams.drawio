<mxCell id="c_svc" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;&lt;b&gt;BookingService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;- rooms: list[Room]&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ find_free_rooms(stay): list[Room]&lt;br&gt;+ reserve(guest, room, stay): BookingResult&lt;br&gt;+ cancel(reservation_id): bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="300" height="124" as="geometry"/></mxCell>
<mxCell id="c_status" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;«enumeration»&lt;br&gt;&lt;b&gt;ReservationStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;Confirmed&lt;br&gt;Cancelled&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="124" as="geometry"/></mxCell>
<mxCell id="c_store" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;&lt;b&gt;ReservationStore&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;- rows: list[Reservation]&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ has_overlap(room, stay): bool&lt;br&gt;+ save(reservation)&lt;br&gt;+ find(id): Reservation&lt;br&gt;+ count_confirmed(room, stay): int&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="280" height="141" as="geometry"/></mxCell>
<mxCell id="c_email" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;&lt;b&gt;EmailSender&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ sent: int&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ send_confirmation(reservation)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="c_guest" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;&lt;b&gt;Guest&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ name: str&lt;br&gt;+ email: str&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="190" height="107" as="geometry"/></mxCell>
<mxCell id="c_res" value="&lt;p style=&quot;margin:4px;text-align:center;&quot;&gt;&lt;b&gt;Reservation&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ id: str&lt;br&gt;+ status: ReservationStatus&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px;&quot;&gt;+ blocks(room, stay): bool&lt;br&gt;+ cancel(): bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="600" width="240" height="124" as="geometry"/></mxCell>
